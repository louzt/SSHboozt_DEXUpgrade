# ================================================================
# SSH Configuration Example - Linux/macOS with Multiplexing
# ================================================================
# This config is for Linux/macOS where multiplexing works perfectly.
# Full OpenSSH support, no "Bad file descriptor" errors.
#
# For Windows users: See ssh_config_windows_no_multiplexing instead
#
# Learn more: https://github.com/louzt/SSHboozt_DEXUpgrade
# ================================================================

# ================================================================
# HOST-SPECIFIC CONFIGURATIONS
# ================================================================

# Example VPS with full optimizations
Host my-vps vps.example.com
    HostName vps.example.com
    User root
    Port 22
    IdentityFile ~/.ssh/id_ed25519
    
    # Multiplexing (works great on Linux/macOS)
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 2h
    
    # Compression
    Compression yes
    
    # Keepalive
    ServerAliveInterval 15
    ServerAliveCountMax 4
    TCPKeepAlive yes
    
    # SOCKS5 Proxy (local port 9998)
    DynamicForward 127.0.0.1:9998
    
    # Modern ciphers and MACs
    Ciphers chacha20-poly1305@openssh.com,aes128-gcm@openssh.com,aes256-gcm@openssh.com
    MACs hmac-sha2-256-etm@openssh.com,hmac-sha2-512-etm@openssh.com
    KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group-exchange-sha256

# Example: GitHub with aggressive multiplexing
Host github github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_github
    
    # Aggressive multiplexing for fast git operations
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 1h
    
    # GitHub-specific
    Compression yes
    StrictHostKeyChecking accept-new

# Example: Jump host / Bastion server
Host bastion
    HostName bastion.company.com
    User jumper
    IdentityFile ~/.ssh/id_rsa_bastion
    
    # Multiplexing for bastion
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 30m
    
    # Bastion-specific
    ForwardAgent yes
    Compression yes

# Example: Internal server via jump host
Host internal-server
    HostName 10.0.1.100
    User admin
    IdentityFile ~/.ssh/id_rsa_internal
    
    # Connect via bastion
    ProxyJump bastion
    
    # Multiplexing
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 15m

# Example: Multiple development servers
Host dev-*.company.local
    User developer
    IdentityFile ~/.ssh/id_rsa_dev
    
    # Shared multiplexing for all dev servers
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 20m
    
    # Dev-specific
    Compression yes
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null

# ================================================================
# GLOBAL DEFAULTS (apply to all hosts)
# ================================================================

Host *
    # Connection timeouts
    ConnectTimeout 30
    ConnectionAttempts 3
    
    # Security
    IdentitiesOnly yes
    PasswordAuthentication yes
    PubkeyAuthentication yes
    
    # Logging
    LogLevel INFO
    
    # Host key verification
    StrictHostKeyChecking ask
    HashKnownHosts no
    
    # Tunnel failure handling
    ExitOnForwardFailure yes
    
    # Add keys to agent automatically
    AddKeysToAgent yes

# ================================================================
# NOTES
# ================================================================
#
# CREATE SOCKETS DIRECTORY:
#   mkdir -p ~/.ssh/sockets
#   chmod 700 ~/.ssh/sockets
#
# INSTALL CONFIG:
#   cp ssh_config_linux_multiplexing ~/.ssh/config
#   chmod 600 ~/.ssh/config
#
# TEST MULTIPLEXING:
#   # First connection (creates master)
#   time ssh my-vps "echo 'First connection'"
#
#   # Second connection (reuses master, much faster)
#   time ssh my-vps "echo 'Second connection'"
#
# CHECK MASTER STATUS:
#   ssh -O check my-vps
#   # Output: Master running (pid=12345)
#
# STOP MASTER:
#   ssh -O stop my-vps
#
# EXIT ALL CONNECTIONS:
#   ssh -O exit my-vps
#
# CLEAN STUCK SOCKETS:
#   rm -f ~/.ssh/sockets/*
#
# DISABLE MULTIPLEXING FOR SINGLE CONNECTION:
#   ssh -o ControlMaster=no -o ControlPath=none my-vps
#
# FORWARD PORT AFTER CONNECTING:
#   ssh -O forward -L 8080:localhost:80 my-vps
#
# CANCEL PORT FORWARD:
#   ssh -O cancel -L 8080:localhost:80 my-vps
#
# ================================================================
# ADVANCED: Using %C vs %h-%p-%r
# ================================================================
#
# %C = SHA1 hash of %l%h%p%r (shorter, obfuscated)
#   Example: ~/.ssh/sockets/a1b2c3d4e5f6...
#   Pros: Shorter paths, privacy
#   Cons: Can't tell what connection it is
#
# %h-%p-%r = hostname-port-user (readable)
#   Example: ~/.ssh/sockets/vps.example.com-22-root
#   Pros: Easy to identify, debug
#   Cons: Longer paths, shows connection details
#
# Both work perfectly on Linux/macOS. Choose based on preference.
#
# ================================================================
